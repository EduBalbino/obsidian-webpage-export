# Full Deploy Script Configuration
# Copy this file to .env and fill in your values

# Path to the obsidian-webpage-export project root
PROJECT_DIR=C:/path/to/obsidian-webpage-export

# Path to the plugin folder inside your vault's .obsidian/plugins directory
VAULT_PLUGIN_DIR=C:/path/to/YourVault/.obsidian/plugins/webpage-html-export

# Path where exported website files will be saved
EXPORT_DIR=C:/path/to/exported_website

# Path to Obsidian executable
OBSIDIAN_EXE=C:/Program Files/Obsidian/Obsidian.exe
